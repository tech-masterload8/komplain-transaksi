# --- OtoMax (READ ONLY) ---
OTOMAX_DB_HOST=127.0.0.1
OTOMAX_DB_PORT=5432
OTOMAX_DB_NAME=otomaxbank
OTOMAX_DB_USER=bankdb
OTOMAX_DB_PASSWORD=

# --- App database (READ/WRITE) ---
APP_DB_HOST=127.0.0.1
APP_DB_PORT=5432
APP_DB_NAME=komplain
APP_DB_USER=bankdb
APP_DB_PASSWORD=

# Encrypted private key from Key Web Developer (single line)
WEB_DEV_PRIVATE_KEY=

# Signed session cookie
SESSION_SECRET=change-this-to-a-long-random-string

# Akun admin CS (dibuat oleh npm run migrate)
CS_PHONE=
CS_PIN=
CS_NAME=Layanan Pelanggan

# App
PORT=3000
APP_URL=http://127.0.0.1:3000

# Local browser testing only. Never enable on production.
ALLOW_DEV_LOGIN=false
DEV_AGENT_CODE=
