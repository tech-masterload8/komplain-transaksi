# --- OtoMax (READ ONLY) ---
OTOMAX_DB_HOST=127.0.0.1
OTOMAX_DB_PORT=5432
OTOMAX_DB_NAME=otomaxbank
OTOMAX_DB_USER=bankdb
OTOMAX_DB_PASSWORD=

# --- App database (READ/WRITE) ---
APP_DB_HOST=127.0.0.1
APP_DB_PORT=5432
APP_DB_NAME=komplain
APP_DB_USER=bankdb
APP_DB_PASSWORD=

# Encrypted private key from Key Web Developer (single line)
WEB_DEV_PRIVATE_KEY=

# Signed session cookie
SESSION_SECRET=change-this-to-a-long-random-string

# Super admin default (dibuat saat migrate / start container)
SUPERADMIN_USERNAME=steinway
SUPERADMIN_PASSWORD=Luminous1ty
SUPERADMIN_NAME=Steinway
# SUPERADMIN_RESET_PASSWORD=true

# Optional: paksa nama kolom OtoMax jika auto-detect salah
# OTOMAX_TRX_ID_COLUMN=kode
# OTOMAX_TRX_RESELLER_COLUMN=kode_reseller
# OTOMAX_TRX_PRODUCT_COLUMN=kode_produk
# OTOMAX_TRX_DATE_COLUMN=tgl_entri
# OTOMAX_RESELLER_KODE_COLUMN=kode

# App
# Produksi aaPanel: 3001 (3000 sudah terpakai monitoring). Lokal boleh 3000.
PORT=3001
APP_URL=https://103.179.67.71/komplain
# Produksi aaPanel: /komplain (wajib rebuild image jika diubah).
# Untuk npm run dev di laptop, kosongkan nilainya agar tetap di http://localhost:3000
NEXT_PUBLIC_BASE_PATH=/komplain

# Local browser testing only. Never enable on production.
ALLOW_DEV_LOGIN=false
DEV_AGENT_CODE=
