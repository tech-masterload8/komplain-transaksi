server {
    listen 80;
    server_name _;

    client_max_body_size 20m;

    # Never serve secrets or git from disk if this vhost has a document root.
    location ~* /\.env {
        deny all;
        return 404;
    }
    location ^~ /.git {
        deny all;
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
server {
    listen 80;
    server_name _;

    client_max_body_size 20m;

    # Never serve secrets or git from disk if this vhost has a document root.
    location ~* /\.env {
        deny all;
        return 404;
    }
    location ^~ /.git {
        deny all;
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Wajib: header Android ENC Key/Signature. Di aaPanel Reverse Proxy,
        # tempel dua baris ini di konfigurasi kustom.
        proxy_set_header Authorization $http_authorization;
        proxy_pass_header Authorization;
        proxy_read_timeout 60s;
    }
}
